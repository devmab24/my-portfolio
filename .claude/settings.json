{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-context7.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Context7 docs were consulted..."
          }
        ]
      }
    ]
  }
}
